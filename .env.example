# Copy to .env.local and fill in. Never commit real values.

# mock = MSW fixtures, fully offline (default when no credentials are configured)
# live = real hackathon API through the same-origin proxy (the API rejects browser CORS)
VITE_API_MODE=mock
VITE_API_BASE_PATH=/api

# Campaigns listed in the header switcher (comma-separated IDs). The API has no list endpoint;
# any other ID can still be typed into the switcher. Defaults to the brief's test campaigns.
VITE_CAMPAIGNS=119,120,122,123

# Where the auth headers come from:
#   client = the browser sends them (VITE_* values are inlined into the JS bundle, so not secret)
#   proxy  = the dev/preview proxy or `npm run serve` injects them from the server-only vars below
VITE_API_CREDENTIALS=client

# Client credentials (only for VITE_API_CREDENTIALS=client)
VITE_API_AUTH_KEY=your-myauthorizationx-value
VITE_API_BASIC_TOKEN=base64-user-colon-password

# Server-only (never exposed to the browser): proxy target and, for proxy credentials, the secrets
API_PROXY_TARGET=https://readie001.uc.r.appspot.com/auth/recording/jobs
API_AUTH_KEY=
API_BASIC_TOKEN=
